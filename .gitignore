# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# 실험 수집 데이터 — 설문 응답과 인터뷰 연락처(개인정보)가 들어간다.
# 절대 커밋하지 말 것.
/.data/

# typescript
*.tsbuildinfo
next-env.d.ts

# 상세페이지 이미지 작업 원본 폴더 — 최종본만 public/product-details/로 복사해
# 커밋한다. 여기는 원본·중복·미사용 시안이 쌓이는 곳이라 저장소에 올리지 않는다.
/지역 별 이미지/
